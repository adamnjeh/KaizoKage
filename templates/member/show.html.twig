{% extends 'base.html.twig' %}
{% block title %}Membre {{ member.email }}{% endblock %}

{% block body %}
<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Profil du membre</h1>
    <a class="btn btn-link" href="{{ path('app_member_index') }}">← Retour à la liste</a>
  </div>

  <dl class="row mb-4">
    <dt class="col-sm-3">Id</dt>
    <dd class="col-sm-9">{{ member.id }}</dd>

    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">{{ member.email }}</dd>
  </dl>

  {# Peut gérer : soit admin, soit le membre lui-même #}
  {% set can_manage = app.user and (is_granted('ROLE_ADMIN') or app.user.id == member.id) %}

  <h2 class="h5 mb-3">Vitrines de ce membre</h2>

  {% if member.vitrines is empty %}
    <p class="text-muted fst-italic">Ce membre n’a pas encore de vitrine.</p>
  {% else %}
    <ul class="list-group mb-3">
      {% for vitrine in member.vitrines %}
        <li class="list-group-item d-flex justify-content-between align-items-center">
          <div>
            <strong>Vitrine #{{ vitrine.id }}</strong><br>
            <span class="text-muted small">{{ vitrine.description }}</span>
          </div>
          <a class="btn btn-sm btn-outline-secondary"
             href="{{ path('vitrine_show', { id: vitrine.id }) }}">
            Voir la vitrine
          </a>
        </li>
      {% endfor %}
    </ul>
  {% endif %}

  {% if can_manage %}
    <a class="btn btn-primary mb-4"
       href="{{ path('app_member_vitrine_new', { id: member.id }) }}">
      Créer une nouvelle vitrine pour ce membre
    </a>
  {% endif %}

  <h2 class="h5 mb-3 mt-4">Galeries de ce membre</h2>

  {% if member.galeries is empty %}
    <p class="text-muted fst-italic">Ce membre n’a pas encore de galerie.</p>
  {% else %}
    <table class="table table-striped align-middle">
      <thead>
        <tr>
          <th>Id</th>
          <th>Description</th>
          <th>Statut</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {% for galerie in member.galeries %}
          <tr>
            <td>{{ galerie.id }}</td>
            <td>{{ galerie.description }}</td>
            <td>
              {% if galerie.published %}
                <span class="badge bg-success">Publique</span>
              {% else %}
                <span class="badge bg-secondary">Privée</span>
              {% endif %}
            </td>
            <td class="text-end">
              <a class="btn btn-sm btn-outline-secondary"
                 href="{{ path('app_galerie_show', {id: galerie.id}) }}">
                Voir
              </a>

              {# Modifier autorisé : admin OU créateur #}
              {% if app.user and (is_granted('ROLE_ADMIN') or (galerie.creator and app.user.id == galerie.creator.id)) %}
                <a class="btn btn-sm btn-outline-primary"
                   href="{{ path('app_galerie_edit', {id: galerie.id}) }}">
                  Modifier
                </a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>

    {% if can_manage %}
      <a class="btn btn-sm btn-primary"
         href="{{ path('app_member_galerie_new', {id: member.id}) }}">
        Créer une nouvelle galerie pour ce membre
      </a>
    {% endif %}
  {% endif %}
</div>
{% endblock %}
