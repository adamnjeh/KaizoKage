{% extends 'base.html.twig' %}

{% block body %}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">Galerie #{{ galerie.id }}</h1>

        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" href="{{ path('app_galerie_index') }}">
                <i class="bi bi-arrow-left"></i> Retour à la liste
            </a>
            <a class="btn btn-primary" href="{{ path('app_galerie_edit', {'id': galerie.id}) }}">
                Modifier
            </a>
            {{ include('galerie/_delete_form.html.twig') }}
        </div>
    </div>

    <table class="table align-middle">
        <tbody>
            <tr>
                <th>Description</th>
                <td>{{ galerie.description }}</td>
            </tr>
            <tr>
                <th>Publiée</th>
                <td>
                    {% if galerie.published %}
                        <span class="badge bg-success">Publique</span>
                    {% else %}
                        <span class="badge bg-secondary">Privée</span>
                    {% endif %}
                </td>
            </tr>
            <tr>
                <th>Figurines</th>
                <td>
                    <ul class="list-unstyled mb-0">
                        {% for figurine in galerie.figurines %}
                            <li>
                                <a href="{{ path('app_galerie_figurine_show', {
                                    galerie_id: galerie.id,
                                    figurine_id: figurine.id
                                }) }}">
                                    {{ figurine.nom }}
								</a>

                            </li>
                        {% else %}
                            <li class="text-muted fst-italic">
                                Aucune figurine dans cette galerie.
                            </li>
                        {% endfor %}
                    </ul>
                </td>
            </tr>
        </tbody>
    </table>
</div>
{% endblock %}
