{% extends 'base.html.twig' %}

{% block title %}Modifier la galerie{% endblock %}

{% block body %}
<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-lg-9">

      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h1 class="h4 mb-1">Modifier la galerie #{{ galerie.id }}</h1>
          <p class="text-secondary small mb-0">
            Mettez à jour la description, la visibilité et les figurines associées.
          </p>
        </div>

        <a class="btn btn-outline-secondary"
           href="{{ path('app_galerie_show', { id: galerie.id }) }}">
          ← Retour à la galerie
        </a>
      </div>

      <div class="card shadow-sm">
        <div class="card-body">
          {{ form_start(form) }}

            {% if form.description is defined %}
              <div class="mb-3">
                {{ form_label(form.description, null, { label_attr: { class: 'form-label' } }) }}
                {{ form_widget(form.description, {
                  attr: {
                    class: 'form-control',
                    placeholder: 'Ex : Galeries One Piece, Figurines Naruto…'
                  }
                }) }}
                {{ form_errors(form.description) }}
              </div>
            {% endif %}

            {% if form.published is defined %}
              <div class="mb-3">
                {{ form_label(form.published, null, { label_attr: { class: 'form-label' } }) }}
                <div class="form-check form-switch">
                  {{ form_widget(form.published, {
                    attr: { class: 'form-check-input' }
                  }) }}
                  <label class="form-check-label small ms-1">
                    Cette galerie est publique
                  </label>
                </div>
                {{ form_errors(form.published) }}
              </div>
            {% endif %}

            {% if form.figurines is defined %}
              <div class="mb-3">
                {{ form_label(form.figurines, 'Figurines dans cette galerie', {
                  label_attr: { class: 'form-label' }
                }) }}
                {{ form_widget(form.figurines, {
                  attr: { class: 'form-select', size: 6 }
                }) }}
                {{ form_errors(form.figurines) }}
              </div>
            {% endif %}

            {{ form_rest(form) }}

            <div class="mt-4 d-flex gap-2">
              <button class="btn btn-primary">
                Mettre à jour
              </button>
              <a href="{{ path('app_galerie_show', { id: galerie.id }) }}"
                 class="btn btn-outline-secondary">
                Annuler
              </a>
            </div>

          {{ form_end(form) }}

          <div class="mt-3">
            {{ include('galerie/_delete_form.html.twig') }}
          </div>
        </div>
      </div>

    </div>
  </div>
</div>
{% endblock %}
