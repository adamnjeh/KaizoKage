{% extends 'base.html.twig' %}
{% block title %}Nouvelle galerie{% endblock %}

{% block body %}
<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Nouvelle galerie pour {{ member.email }}</h1>
    <a class="btn btn-link" href="{{ path('app_member_show', {id: member.id}) }}">
      ← Retour au membre
    </a>
  </div>

  {{ form_start(form) }}
    {{ form_row(form.description) }}
    {{ form_row(form.published) }}
    {{ form_row(form.figurines) }}

    <button class="btn btn-primary mt-3">Enregistrer</button>
  {{ form_end(form) }}
</div>
{% endblock %}
