{% extends 'base.html.twig' %}
{% block title %}Accueil{% endblock %}

{% block body %}
<section class="kk-hero py-5">
  <div class="container">
    <div class="row align-items-center g-4">
      <div class="col-lg-7">
        <h1 class="display-6 fw-bold mb-3">
          {% if app.user %}
            Bonjour {{ app.user.email }} 👋
          {% else %}
            Bienvenue sur KaizoKage 👋
          {% endif %}
        </h1>

        <p class="lead text-secondary mb-4">
          Gérez vos <strong>vitrines</strong>, <strong>figurines</strong> et <strong>galeries</strong> dans un seul espace.
        </p>

        <div class="d-flex flex-wrap gap-2">
          {% if app.user %}
            <a href="{{ path('app_member_show', { id: app.user.id }) }}"
               class="btn btn-primary btn-lg">
              <i class="bi bi-person-circle"></i> Mon espace
            </a>
            <a href="{{ path('vitrine_index') }}" class="btn btn-outline-primary btn-lg">
              <i class="bi bi-collection"></i> Mes vitrines
            </a>
            <a href="{{ path('app_galerie_index') }}" class="btn btn-outline-secondary btn-lg">
              <i class="bi bi-images"></i> Galeries
            </a>
          {% else %}
            <a href="{{ path('app_login') }}" class="btn btn-primary btn-lg">
              <i class="bi bi-box-arrow-in-right"></i> Se connecter
            </a>
            <a href="{{ path('vitrine_index') }}" class="btn btn-outline-primary btn-lg">
              <i class="bi bi-collection"></i> Voir les vitrines
            </a>
          {% endif %}
        </div>
      </div>

      <div class="col-lg-5">
        <div class="ratio ratio-1x1 bg-white rounded shadow-sm reveal">
          <img class="ratio-img"
               src="{{ asset('kaizokage.png') }}"
               alt="KaizoKage">
        </div>
      </div>
    </div>
  </div>
</section>


{% endblock %}
