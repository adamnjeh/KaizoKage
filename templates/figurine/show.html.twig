{% extends 'base.html.twig' %}

{% block title %}{{ figurine.nom }}{% endblock %}

{% block body %}
<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">{{ figurine.nom }}</h1>

    <div class="d-flex gap-2">
      <a class="btn btn-outline-secondary"
         href="{{ path('app_figurine_index') }}">
        ← Retour à la liste
      </a>
      <a class="btn btn-primary"
         href="{{ path('app_figurine_edit', { id: figurine.id }) }}">
        Modifier
      </a>
      {{ include('figurine/_delete_form.html.twig') }}
    </div>
  </div>

  <div class="row">
    <div class="col-md-4 mb-3">
      {% if figurine.imageFilename %}
        <img
          src="/uploads/figurines/{{ figurine.imageFilename }}"
          alt="{{ figurine.nom }}"
          class="img-fluid rounded">
      {% else %}
        {% if placeholder_img is defined %}
          <img
            src="{{ asset(placeholder_img) }}"
            alt="{{ figurine.nom }}"
            class="img-fluid rounded">
        {% else %}
          <img
            src="{{ asset('startbootstrap-shop-homepage-gh-pages/assets/img/placeholder.png') }}"
            alt="{{ figurine.nom }}"
            class="img-fluid rounded">
        {% endif %}
      {% endif %}
    </div>

    <div class="col-md-8">
      <dl class="row">
        <dt class="col-sm-3">Id</dt>
        <dd class="col-sm-9">{{ figurine.id }}</dd>

        <dt class="col-sm-3">Nom</dt>
        <dd class="col-sm-9">{{ figurine.nom }}</dd>

        <dt class="col-sm-3">Vitrine</dt>
        <dd class="col-sm-9">
          {% if figurine.vitrine %}
            <a href="{{ path('vitrine_show', { id: figurine.vitrine.id }) }}">
              Vitrine #{{ figurine.vitrine.id }}
            </a>
          {% else %}
            <span class="text-muted">Aucune</span>
          {% endif %}
        </dd>
      </dl>
    </div>
  </div>
</div>
{% endblock %}
