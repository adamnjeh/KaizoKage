{% extends 'base.html.twig' %}

{% block title %}Vitrine #{{ vitrine.id }}{% endblock %}

{% block body %}
<div class="container py-4">

  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Vitrine #{{ vitrine.id }}</h1>

    <a class="btn btn-outline-secondary"
       href="{{ path('vitrine_index') }}">
      ← Retour à la liste
    </a>
  </div>

  <p class="text-muted mb-4">{{ vitrine.description }}</p>

  <h2 class="h5 mb-3">Figurines dans cette vitrine</h2>

  {% if vitrine.figurines is empty %}
    <div class="alert alert-info">Aucune figurine dans cette vitrine.</div>
  {% else %}
    <div class="row g-3">
      {% for f in vitrine.figurines %}
        <div class="col-6 col-md-4 col-lg-3">
          <div class="card h-100 shadow-sm">

            <div class="ratio ratio-1x1 bg-white">
              {% if f.imageFilename %}
                <img class="ratio-img"
                     src="/uploads/figurines/{{ f.imageFilename }}"
                     alt="{{ f.nom }}">
              {% else %}
                <img class="ratio-img"
                     src="{{ asset(placeholder_img) }}"
                     alt="{{ f.nom }}">
              {% endif %}
            </div>

            <div class="card-body d-flex flex-column">
              <h2 class="h6 mb-2 text-truncate" title="{{ f.nom }}">
                {{ f.nom }}
              </h2>

              <div class="mt-auto d-flex justify-content-between align-items-center">
                <a href="{{ path('app_figurine_show', { id: f.id }) }}"
                   class="btn btn-sm btn-outline-secondary">
                  Voir
                </a>

                <a href="{{ path('app_figurine_edit', { id: f.id }) }}"
                   class="btn btn-sm btn-outline-primary">
                  Modifier
                </a>
              </div>
            </div>

          </div>
        </div>
      {% endfor %}
    </div>
  {% endif %}

</div>
{% endblock %}
