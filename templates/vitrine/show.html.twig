{% extends 'base.html.twig' %}

{% block title %}Vitrine #{{ vitrine.id }}{% endblock %}

{% block body %}
<div class="container py-4">

  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <h1 class="h4 mb-0">Vitrine #{{ vitrine.id }}</h1>
      <p class="text-muted small mb-0">{{ vitrine.description }}</p>
    </div>

    <div class="d-flex gap-2">
      {% if app.user and vitrine.owner and app.user.id == vitrine.owner.id %}
        <a class="btn btn-primary"
           href="{{ path('vitrine_edit', { id: vitrine.id }) }}">
          <i class="bi bi-pencil-square"></i> Modifier la vitrine
        </a>
      {% endif %}
      <a class="btn btn-outline-secondary"
         href="{{ path('vitrine_index') }}">
        ← Retour à la liste
      </a>
    </div>
  </div>

  <div class="row mb-4">
    <div class="col-md-4 mb-3">
      <div class="ratio ratio-4x3 bg-white border rounded">
        {% if vitrine.imageFilename %}
          <img class="ratio-img"
               src="/uploads/vitrines/{{ vitrine.imageFilename }}"
               alt="Vitrine #{{ vitrine.id }}">
        {% else %}
          <img class="ratio-img"
               src="{{ asset(placeholder_img) }}"
               alt="Vitrine #{{ vitrine.id }}">
        {% endif %}
      </div>
    </div>
    <div class="col-md-8">
      <h2 class="h5 mb-3">Figurines dans cette vitrine</h2>

      {% if vitrine.figurines is empty %}
        <div class="alert alert-info">Aucune figurine dans cette vitrine.</div>
      {% else %}
        <div class="row g-3">
          {% for f in vitrine.figurines %}
            <div class="col-6 col-md-4 col-lg-3">
              <div class="card h-100 shadow-sm position-relative">
                <div class="ratio ratio-1x1 bg-white">
                  {% if f.imageFilename %}
                    <img class="ratio-img"
                         src="/uploads/figurines/{{ f.imageFilename }}"
                         alt="{{ f.nom }}">
                  {% else %}
                    <img class="ratio-img"
                         src="{{ asset(placeholder_img) }}"
                         alt="{{ f.nom }}">
                  {% endif %}
                </div>
                <div class="card-body d-flex flex-column">
                  <h2 class="h6 mb-2 text-truncate" title="{{ f.nom }}">
                    {{ f.nom }}
                  </h2>
                </div>

                {# Toute la carte ouvre la fiche de la figurine #}
                <a href="{{ path('app_figurine_show', { id: f.id }) }}"
                   class="stretched-link"></a>
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</div>
{% endblock %}
