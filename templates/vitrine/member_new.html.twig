{% extends 'base.html.twig' %}

{% block title %}Nouvelle vitrine{% endblock %}

{% block body %}
<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-lg-10">

      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h1 class="h4 mb-1">Créer une vitrine pour {{ member.email }}</h1>
          <p class="text-secondary small mb-0">
            Donnez un nom à votre vitrine et ajoutez une image pour la représenter.
          </p>
        </div>

        <a class="btn btn-outline-secondary"
           href="{{ path('app_member_show', { id: member.id }) }}">
          ← Retour au profil
        </a>
      </div>

      <div class="row g-4">
        <div class="col-md-4">
          <div class="card h-100 shadow-sm">
            <div class="card-body">
              <p class="text-muted small mb-2">Aperçu de l’image</p>

              <div class="ratio ratio-4x3 bg-white border rounded mb-2">
                {% if placeholder_img is defined %}
                  <img
                    id="vitrine-preview-img"
                    class="ratio-img"
                    src="{{ asset(placeholder_img) }}"
                    alt="Prévisualisation de la vitrine">
                {% else %}
                  <img
                    id="vitrine-preview-img"
                    class="ratio-img"
                    src="https://via.placeholder.com/800x600?text=Vitrine"
                    alt="Prévisualisation de la vitrine">
                {% endif %}
              </div>
            </div>
          </div>
        </div>

        <div class="col-md-8">
          <div class="card shadow-sm">
            <div class="card-body">
              {{ form_start(form) }}

                <div class="mb-3">
                  {{ form_label(form.description, null, { label_attr: { class: 'form-label' } }) }}
                  {{ form_widget(form.description, {
                    attr: {
                      class: 'form-control',
                      placeholder: 'Ex : Vitrine One Piece, Vitrine Naruto…'
                    }
                  }) }}
                  {{ form_errors(form.description) }}
                </div>

                {% if form.imageFile is defined %}
                  <div class="mb-3">
                    {{ form_label(form.imageFile, null, { label_attr: { class: 'form-label' } }) }}
                    {{ form_widget(form.imageFile, {
                      attr: { class: 'form-control kk-vitrine-image-input' }
                    }) }}
                    {{ form_errors(form.imageFile) }}
                    <div class="form-text">
                      Formats acceptés : JPG, PNG, WebP. Taille maximale 2 Mo.
                    </div>
                  </div>
                {% endif %}

                <div class="mt-4 d-flex gap-2">
                  <button class="btn btn-primary">
                    <i class="bi bi-check-circle"></i> Créer la vitrine
                  </button>
                  <a href="{{ path('app_member_show', { id: member.id }) }}"
                     class="btn btn-outline-secondary">
                    Annuler
                  </a>
                </div>

              {{ form_end(form) }}
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script>
    (function(){
      const fileInput = document.querySelector('.kk-vitrine-image-input');
      const preview   = document.getElementById('vitrine-preview-img');
      if (!fileInput || !preview) return;

      fileInput.addEventListener('change', function () {
        const file = fileInput.files && fileInput.files[0];
        if (!file) return;

        if (!file.type || !file.type.startsWith('image/')) {
          if (typeof window.showToast === 'function') {
            window.showToast('Merci de choisir un fichier image.');
          }
          fileInput.value = '';
          return;
        }

        const reader = new FileReader();
        reader.onload = function (e) {
          preview.src = e.target.result;
        };
        reader.readAsDataURL(file);
      });
    })();
  </script>
{% endblock %}
