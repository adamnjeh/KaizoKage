{% extends 'base.html.twig' %}
{% block title %}Modifier la vitrine{% endblock %}

{% block body %}
<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-lg-10">

      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h1 class="h4 mb-1">Modifier la vitrine #{{ vitrine.id }}</h1>
          <p class="text-secondary small mb-0">
            Mettez à jour la description et l’image de la vitrine.
          </p>
        </div>

        <a class="btn btn-outline-secondary"
           href="{{ path('vitrine_show', { id: vitrine.id }) }}">
          ← Retour à la vitrine
        </a>
      </div>

      <div class="row g-4">
        {# Colonne gauche : aperçu actuel + preview #}
        <div class="col-md-4">
          <div class="card h-100 shadow-sm">
            <div class="card-body">
              <p class="text-muted small mb-2">Aperçu de l’image</p>

              <div class="ratio ratio-4x3 bg-white border rounded mb-2">
                {% if vitrine.imageFilename %}
                  <img
                    id="vitrine-preview-img"
                    class="ratio-img"
                    src="/uploads/vitrines/{{ vitrine.imageFilename }}"
                    alt="Vitrine #{{ vitrine.id }}">
                {% else %}
                  {% if placeholder_img is defined %}
                    <img
                      id="vitrine-preview-img"
                      class="ratio-img"
                      src="{{ asset(placeholder_img) }}"
                      alt="Vitrine #{{ vitrine.id }}">
                  {% else %}
                    <img
                      id="vitrine-preview-img"
                      class="ratio-img"
                      src="https://via.placeholder.com/800x600?text=Vitrine"
                      alt="Vitrine #{{ vitrine.id }}">
                  {% endif %}
                {% endif %}
              </div>

              <p class="text-muted small mb-0">
                Choisissez une nouvelle image pour mettre à jour la vitrine.
              </p>
            </div>
          </div>
        </div>

        {# Colonne droite : formulaire #}
        <div class="col-md-8">
          <div class="card shadow-sm">
            <div class="card-body">
              {{ form_start(form) }}

                <div class="mb-3">
                  {{ form_label(form.description, null, { label_attr: { class: 'form-label' } }) }}
                  {{ form_widget(form.description, {
                    attr: {
                      class: 'form-control',
                      placeholder: 'Ex : Vitrine One Piece, Vitrine Naruto…'
                    }
                  }) }}
                  {{ form_errors(form.description) }}
                </div>

                {% if form.imageFile is defined %}
                  <div class="mb-3">
                    {{ form_label(form.imageFile, null, { label_attr: { class: 'form-label' } }) }}
                    {{ form_widget(form.imageFile, {
                      attr: { class: 'form-control kk-vitrine-image-input' }
                    }) }}
                    {{ form_errors(form.imageFile) }}
                    <div class="form-text">
                      Vous pouvez laisser vide pour conserver l’image actuelle.
                    </div>
                  </div>
                {% endif %}

                <button class="btn btn-primary mt-3">
                  Mettre à jour
                </button>

              {{ form_end(form) }}
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script>
    (function(){
      const fileInput = document.querySelector('.kk-vitrine-image-input');
      const preview   = document.getElementById('vitrine-preview-img');
      if (!fileInput || !preview) return;

      fileInput.addEventListener('change', function () {
        const file = fileInput.files && fileInput.files[0];
        if (!file) return;

        if (!file.type || !file.type.startsWith('image/')) {
          if (typeof window.showToast === 'function') {
            window.showToast('Merci de choisir un fichier image.');
          }
          fileInput.value = '';
          return;
        }

        const reader = new FileReader();
        reader.onload = function (e) {
          preview.src = e.target.result;
        };
        reader.readAsDataURL(file);
      });
    })();
  </script>
{% endblock %}
